---
export const prerender = false;

import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/ui/Navbar.astro";
import Footer from "../../components/sections/Footer.astro";
import { supabase } from "../../lib/supabaseClient";

const formatearPrecio = (valor: unknown) => {
  const texto = String(valor ?? "").trim();

  if (!texto) return "";

  const esSoloNumero = /^[\d.,\s]+$/.test(texto);

  if (!esSoloNumero) return texto;

  const numero = Number(
    texto.replace(/\s+/g, "").replace(/,/g, "")
  );

  return Number.isFinite(numero)
    ? `$${numero.toLocaleString("es-MX")} MXN`
    : texto;
};

const { id } = Astro.params;

const { data: terreno, error } = await supabase
  .from("Terrenos")
  .select(
    "id, titulo, descripcion, precio, imagenes, medidas, ubicacion, tipo, fecha, google_maps"
  )
  .eq("id", id)
  .single();

const imagenes = Array.isArray(terreno?.imagenes)
  ? (terreno.imagenes as string[])
  : [];

const imagenPrincipal = imagenes[0] || "/no-image.jpg";

const whatsappHref = terreno
  ? `https://wa.me/524751080850?text=${encodeURIComponent(
      `Hola, quiero información sobre la propiedad: ${terreno.titulo}${
        terreno.ubicacion
          ? `, ubicada en ${terreno.ubicacion}`
          : ""
      }.`
    )}`
  : "#";
---

<Layout>
  <section
    class="min-h-screen bg-gradient-to-b from-sky-950 via-sky-900 to-sky-950 text-white"
  >
    <Navbar />

    <main class="mx-auto mb-12 max-w-7xl px-4 sm:px-6">
      {
        error && (
          <div class="mt-8 rounded-2xl border border-red-400/30 bg-red-500/10 p-6 text-red-100">
            No se pudo cargar la propiedad.
          </div>
        )
      }

      {
        !error && !terreno && (
          <div class="mt-8 rounded-2xl border border-white/10 bg-white/5 p-6 text-white/80">
            No se encontró la propiedad solicitada.
          </div>
        )
      }

      {
        terreno && (
          <article class="mt-8 overflow-hidden rounded-[2rem] bg-white text-slate-900 shadow-2xl shadow-black/25">
            <div class="grid grid-cols-1 items-start lg:grid-cols-[minmax(0,1.55fr)_minmax(350px,0.85fr)]">
              <!-- GALERÍA -->
              <div
                class="min-w-0 self-start bg-slate-100 p-3 sm:p-5"
                data-property-gallery
              >
                <!-- Imagen principal -->
                <div class="group relative overflow-hidden rounded-2xl bg-slate-200">
                  <img
                    id="property-main-image"
                    src={imagenPrincipal}
                    alt={terreno.titulo}
                    class="h-[19rem] w-full object-cover transition duration-300 sm:h-[29rem] lg:h-[34rem]"
                    loading="eager"
                    fetchpriority="high"
                    decoding="async"
                  />

                  {imagenes.length > 1 && (
                    <>
                      <button
                        type="button"
                        id="gallery-previous"
                        aria-label="Ver imagen anterior"
                        class="absolute left-3 top-1/2 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-slate-950/60 text-2xl text-white backdrop-blur-sm transition hover:scale-110 hover:bg-slate-950/80 lg:opacity-0 lg:group-hover:opacity-100"
                      >
                        ‹
                      </button>

                      <button
                        type="button"
                        id="gallery-next"
                        aria-label="Ver siguiente imagen"
                        class="absolute right-3 top-1/2 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-slate-950/60 text-2xl text-white backdrop-blur-sm transition hover:scale-110 hover:bg-slate-950/80 lg:opacity-0 lg:group-hover:opacity-100"
                      >
                        ›
                      </button>

                      <div class="absolute bottom-3 right-3 rounded-full bg-slate-950/70 px-3 py-1.5 text-xs font-semibold text-white backdrop-blur-sm">
                        <span id="gallery-current-number">1</span>
                        <span class="text-white/70">
                          {" "}/ {imagenes.length}
                        </span>
                      </div>
                    </>
                  )}
                </div>

                <!-- Miniaturas -->
                {imagenes.length > 0 && (
                  <div class="mt-3 flex gap-3 overflow-x-auto pb-2 sm:mt-4">
                    {imagenes.map((img: string, index: number) => (
                      <button
                        type="button"
                        class:list={[
                          "gallery-thumbnail relative shrink-0 overflow-hidden rounded-xl border-2 bg-slate-200 transition duration-200",
                          "w-28 sm:w-36 lg:w-40",
                          index === 0
                            ? "border-sky-600 opacity-100 ring-2 ring-sky-200"
                            : "border-transparent opacity-65 hover:opacity-100",
                        ]}
                        data-index={index}
                        aria-label={`Ver imagen ${index + 1}`}
                        aria-current={index === 0 ? "true" : "false"}
                      >
                        <img
                          src={img}
                          alt={`${terreno.titulo}, imagen ${index + 1}`}
                          class="aspect-video h-full w-full object-cover"
                          loading={index < 4 ? "eager" : "lazy"}
                          decoding="async"
                        />

                        <span class="absolute inset-0 bg-sky-950/0 transition hover:bg-sky-950/10" />
                      </button>
                    ))}
                  </div>
                )}
              </div>

              <!-- INFORMACIÓN -->
              <div class="bg-white p-5 sm:p-7 lg:p-8">
                <!-- Tipo -->
                <div class="flex flex-wrap items-center gap-2">
                  <span class="rounded-full bg-sky-950 px-3.5 py-1.5 text-[0.7rem] font-bold uppercase tracking-[0.16em] text-white">
                    Propiedad
                  </span>

                  {terreno.tipo && (
                    <span class="rounded-full border border-sky-200 bg-sky-50 px-3.5 py-1.5 text-[0.7rem] font-bold uppercase tracking-[0.16em] text-sky-800">
                      {terreno.tipo}
                    </span>
                  )}
                </div>

                <!-- Título -->
                <h1 class="mt-4 text-2xl font-bold leading-tight tracking-tight text-sky-950 sm:text-3xl lg:text-[2.15rem]">
                  {terreno.titulo}
                </h1>

                <!-- Precio -->
                <div class="mt-4 border-b border-slate-200 pb-5">
                  <p class="text-3xl font-bold tracking-tight text-emerald-700">
                    {formatearPrecio(terreno.precio)}
                  </p>

                  {terreno.fecha && (
                    <p class="mt-1.5 text-xs text-slate-500">
                      Publicado el{" "}
                      {new Date(terreno.fecha).toLocaleDateString(
                        "es-MX",
                        {
                          day: "numeric",
                          month: "long",
                          year: "numeric",
                        }
                      )}
                    </p>
                  )}
                </div>

                <!-- Descripción integrada -->
                {terreno.descripcion && (
                  <div
                    id="property-description-container"
                    class="border-b border-slate-200 py-5"
                  >
                    <div class="mb-2 flex items-center gap-2">
                      <span class="h-5 w-1 rounded-full bg-sky-700" />

                      <h2 class="text-sm font-bold uppercase tracking-[0.12em] text-sky-950">
                        Descripción
                      </h2>
                    </div>

                    <p
                      id="property-description"
                      class="description-collapsed whitespace-pre-line break-words text-sm leading-6 text-slate-600 sm:text-[0.95rem] sm:leading-7"
                    >
                      {terreno.descripcion}
                    </p>

                    <button
                      type="button"
                      id="description-toggle"
                      class="mt-3 hidden items-center gap-1 text-sm font-bold text-sky-800 transition hover:text-sky-600"
                      aria-expanded="false"
                    >
                      <span id="description-toggle-text">
                        Ver descripción completa
                      </span>

                      <svg
                        id="description-toggle-icon"
                        class="h-4 w-4 transition-transform"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        aria-hidden="true"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="m6 9 6 6 6-6"
                        />
                      </svg>
                    </button>
                  </div>
                )}

                <!-- Medidas y ubicación -->
                <div class="grid gap-3 py-5">
                  {terreno.medidas && (
                    <div class="flex items-start gap-3">
                      <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-sky-50 text-sky-800">
                        <svg
                          class="h-5 w-5"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.8"
                          aria-hidden="true"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M4 20 20 4M8 4h12v12M4 8v12h12"
                          />
                        </svg>
                      </div>

                      <div class="min-w-0">
                        <p class="text-xs font-bold uppercase tracking-[0.14em] text-slate-400">
                          Medidas
                        </p>

                        <p class="mt-0.5 font-semibold text-slate-800">
                          {terreno.medidas}
                        </p>
                      </div>
                    </div>
                  )}

                  {terreno.ubicacion && (
                    <div class="flex items-start gap-3">
                      <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-sky-50 text-sky-800">
                        <svg
                          class="h-5 w-5"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.8"
                          aria-hidden="true"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M12 21s7-5.2 7-12a7 7 0 1 0-14 0c0 6.8 7 12 7 12Z"
                          />
                          <circle cx="12" cy="9" r="2.5" />
                        </svg>
                      </div>

                      <div class="min-w-0">
                        <p class="text-xs font-bold uppercase tracking-[0.14em] text-slate-400">
                          Ubicación
                        </p>

                        <p class="mt-0.5 font-semibold leading-6 text-slate-800">
                          {terreno.ubicacion}
                        </p>

                        {terreno.google_maps && (
                          <a
                            href={terreno.google_maps}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="mt-1.5 inline-flex items-center gap-1 text-sm font-bold text-sky-800 transition hover:text-sky-600"
                          >
                            Ver ubicación en el mapa
                            <span aria-hidden="true">↗</span>
                          </a>
                        )}
                      </div>
                    </div>
                  )}
                </div>

                <!-- Acciones -->
                <div class="flex flex-col gap-3 border-t border-slate-200 pt-5">
                  <a
                    href={whatsappHref}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center justify-center gap-2 rounded-xl bg-emerald-600 px-5 py-3.5 text-center font-bold text-white shadow-lg shadow-emerald-900/15 transition hover:-translate-y-0.5 hover:bg-emerald-700"
                  >
                    <svg
                      class="h-5 w-5"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                      aria-hidden="true"
                    >
                      <path d="M12.04 2a9.84 9.84 0 0 0-8.52 14.75L2 22l5.38-1.41A9.99 9.99 0 1 0 12.04 2Zm0 17.98a8.04 8.04 0 0 1-4.1-1.12l-.3-.18-3.2.84.85-3.11-.2-.32a8.06 8.06 0 1 1 6.95 3.89Zm4.42-6.04c-.24-.12-1.43-.7-1.65-.79-.22-.08-.38-.12-.54.12-.16.24-.62.79-.76.95-.14.16-.28.18-.52.06-.24-.12-1.02-.38-1.94-1.2-.72-.64-1.2-1.43-1.34-1.67-.14-.24-.02-.37.1-.49.11-.11.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.42-.06-.12-.54-1.3-.74-1.78-.19-.47-.39-.41-.54-.42h-.46c-.16 0-.42.06-.64.3-.22.24-.84.82-.84 2s.86 2.32.98 2.48c.12.16 1.69 2.58 4.1 3.62.57.25 1.02.39 1.37.5.58.18 1.1.16 1.51.1.46-.07 1.43-.59 1.63-1.15.2-.56.2-1.04.14-1.14-.06-.1-.22-.16-.46-.28Z" />
                    </svg>

                    Contactar por WhatsApp
                  </a>

                  <a
                    href="/Terrenos"
                    class="inline-flex items-center justify-center rounded-xl border border-slate-300 bg-white px-5 py-3 font-bold text-sky-950 transition hover:border-sky-800 hover:bg-sky-50"
                  >
                    Volver al listado
                  </a>
                </div>
              </div>
            </div>
          </article>
        )
      }
    </main>

    <Footer />
  </section>
</Layout>

<style>
  .description-collapsed {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 6;
  }

  .description-expanded {
    display: block;
    overflow: visible;
    -webkit-line-clamp: unset;
  }

  [data-property-gallery] {
    scrollbar-color: #64748b transparent;
    scrollbar-width: thin;
  }
</style>

<script>
  const gallery = document.querySelector<HTMLElement>(
    "[data-property-gallery]"
  );

  if (gallery) {
    const mainImage = gallery.querySelector<HTMLImageElement>(
      "#property-main-image"
    );

    const thumbnails = Array.from(
      gallery.querySelectorAll<HTMLButtonElement>(
        ".gallery-thumbnail"
      )
    );

    const previousButton =
      gallery.querySelector<HTMLButtonElement>(
        "#gallery-previous"
      );

    const nextButton =
      gallery.querySelector<HTMLButtonElement>("#gallery-next");

    const currentNumber =
      gallery.querySelector<HTMLElement>(
        "#gallery-current-number"
      );

    let currentIndex = 0;

    const showImage = (requestedIndex: number) => {
      if (!mainImage || thumbnails.length === 0) return;

      currentIndex =
        (requestedIndex + thumbnails.length) %
        thumbnails.length;

      const selectedThumbnail = thumbnails[currentIndex];

      const selectedImage =
        selectedThumbnail.querySelector<HTMLImageElement>("img");

      if (!selectedImage) return;

      mainImage.style.opacity = "0.45";

      window.setTimeout(() => {
        mainImage.src = selectedImage.src;
        mainImage.alt = selectedImage.alt;
        mainImage.style.opacity = "1";
      }, 120);

      thumbnails.forEach((thumbnail, index) => {
        const isActive = index === currentIndex;

        thumbnail.classList.toggle(
          "border-sky-600",
          isActive
        );

        thumbnail.classList.toggle("ring-2", isActive);
        thumbnail.classList.toggle("ring-sky-200", isActive);
        thumbnail.classList.toggle("opacity-100", isActive);

        thumbnail.classList.toggle(
          "border-transparent",
          !isActive
        );

        thumbnail.classList.toggle("opacity-65", !isActive);

        thumbnail.setAttribute(
          "aria-current",
          isActive ? "true" : "false"
        );
      });

      if (currentNumber) {
        currentNumber.textContent = String(currentIndex + 1);
      }

      selectedThumbnail.scrollIntoView({
        behavior: "smooth",
        block: "nearest",
        inline: "center",
      });
    };

    thumbnails.forEach((thumbnail, index) => {
      thumbnail.addEventListener("click", () => {
        showImage(index);
      });
    });

    previousButton?.addEventListener("click", () => {
      showImage(currentIndex - 1);
    });

    nextButton?.addEventListener("click", () => {
      showImage(currentIndex + 1);
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft") {
        showImage(currentIndex - 1);
      }

      if (event.key === "ArrowRight") {
        showImage(currentIndex + 1);
      }
    });
  }

  // Mostrar u ocultar la descripción completa
  const description =
    document.querySelector<HTMLElement>(
      "#property-description"
    );

  const descriptionToggle =
    document.querySelector<HTMLButtonElement>(
      "#description-toggle"
    );

  const descriptionToggleText =
    document.querySelector<HTMLElement>(
      "#description-toggle-text"
    );

  const descriptionToggleIcon =
    document.querySelector<HTMLElement>(
      "#description-toggle-icon"
    );

  if (description && descriptionToggle) {
    const checkDescriptionHeight = () => {
      const isExpanded =
        description.classList.contains(
          "description-expanded"
        );

      if (isExpanded) return;

      if (
        description.scrollHeight >
        description.clientHeight + 2
      ) {
        descriptionToggle.classList.remove("hidden");
        descriptionToggle.classList.add("inline-flex");
      } else {
        descriptionToggle.classList.add("hidden");
        descriptionToggle.classList.remove("inline-flex");
      }
    };

    window.requestAnimationFrame(checkDescriptionHeight);

    window.addEventListener(
      "resize",
      checkDescriptionHeight
    );

    descriptionToggle.addEventListener("click", () => {
      const isExpanded =
        description.classList.toggle(
          "description-expanded"
        );

      description.classList.toggle(
        "description-collapsed",
        !isExpanded
      );

      descriptionToggle.setAttribute(
        "aria-expanded",
        String(isExpanded)
      );

      if (descriptionToggleText) {
        descriptionToggleText.textContent = isExpanded
          ? "Mostrar menos"
          : "Ver descripción completa";
      }

      descriptionToggleIcon?.classList.toggle(
        "rotate-180",
        isExpanded
      );
    });
  }

  // Ocultar navbar al bajar y mostrarlo al subir
  const nav = document.querySelector<HTMLElement>("nav");

  if (nav) {
    nav.style.transition =
      "transform 280ms ease, opacity 220ms ease";

    let lastY = window.scrollY;
    let ticking = false;

    const onScroll = () => {
      const currentY = window.scrollY;

      if (!ticking) {
        window.requestAnimationFrame(() => {
          if (currentY > lastY && currentY > 60) {
            nav.style.transform = "translateY(-110%)";
            nav.style.opacity = "0";
            nav.style.pointerEvents = "none";
          } else {
            nav.style.transform = "";
            nav.style.opacity = "";
            nav.style.pointerEvents = "";
          }

          lastY = currentY;
          ticking = false;
        });

        ticking = true;
      }
    };

    window.addEventListener("scroll", onScroll, {
      passive: true,
    });

    window.addEventListener("pageshow", () => {
      nav.style.transform = "";
      nav.style.opacity = "";
      nav.style.pointerEvents = "";
    });
  }
</script>
---
import Navbar from "./Navbar.astro";
interface Props {
  h2Title: string;
  srcImage: string;
  description: string;
  class?: string;
}
const { h2Title, srcImage, description, class: className = "" } = Astro.props as Props;
---
<section class:list={["property-hero", className]} aria-labelledby="hero-title">
  <img src={srcImage} alt="" class="hero-image" loading="eager" fetchpriority="high" decoding="async" />
  <div class="hero-shade" aria-hidden="true"></div>
  <Navbar isOverlay={true} />
  <div class="hero-container">
    <div class="hero-copy">
      <p class="hero-eyebrow"><span aria-hidden="true"></span>Encarnación de Díaz · Jalisco</p>
      <h1 id="hero-title">{h2Title}</h1>
      <p class="hero-description">{description}</p>
      <div class="hero-actions">
        <a href="/Terrenos" class="hero-primary">Ver terrenos <span aria-hidden="true">↗</span></a>
        <a href="#Video-Terrenos" class="hero-video"><span class="play" aria-hidden="true">▶</span>Conoce el lugar</a>
      </div>
    </div>
    <div class="hero-footer"><p>Noé Aguilera · Bienes raíces</p><a href="/MapaTerrenos">Explorar ubicación <span aria-hidden="true">↗</span></a></div>
  </div>
</section>
<style>
  .property-hero { --cream:#f5f1e8; --gold:#d5bc92; position:relative; isolation:isolate; display:flex; min-height:780px; min-height:max(780px,100svh); background:#18241e; color:var(--cream); font-family:"Manrope",Arial,sans-serif; }
  .hero-image,.hero-shade { position:absolute; inset:0; width:100%; height:100%; pointer-events:none; }
  .hero-image { z-index:-3; object-fit:cover; object-position:center; }
  .hero-shade { z-index:-2; background:linear-gradient(90deg,rgba(12,23,18,.9),rgba(12,23,18,.6) 45%,rgba(12,23,18,.15)),linear-gradient(0deg,rgba(8,15,11,.65),transparent 45%,rgba(8,15,11,.3)); }
  .hero-container { box-sizing:border-box; width:min(100%,1440px); margin-inline:auto; display:flex; flex-direction:column; padding:190px clamp(24px,6vw,96px) 0; }
  .hero-copy { margin-block:auto; padding:40px 0 90px; max-width:800px; }
  .hero-eyebrow { display:flex; align-items:center; gap:14px; margin:0 0 24px; color:var(--gold); font-size:11px; font-weight:600; letter-spacing:.18em; text-transform:uppercase; line-height:1.8; }
  .hero-eyebrow span { width:36px; height:1px; background:currentColor; flex-shrink:0; }
  h1 { margin:0; max-width:13ch; font-family:"Cormorant Garamond",Georgia,serif; font-size:clamp(3.8rem,7.5vw,7.5rem); font-weight:400; line-height:.98; letter-spacing:-.035em; text-wrap:balance; }
  .hero-description { max-width:43ch; margin:28px 0 0; color:rgba(245,241,232,.85); font-size:17px; line-height:1.8; text-wrap:pretty; }
  .hero-actions { display:flex; flex-wrap:wrap; align-items:center; gap:24px 34px; margin-top:36px; }
  .hero-primary { display:inline-flex; min-height:56px; box-sizing:border-box; align-items:center; justify-content:space-between; gap:40px; padding:16px 24px; background:var(--cream); color:#18241e; font-size:14px; font-weight:600; text-decoration:none; transition:background .2s; }
  .hero-primary:hover { background:var(--gold); }
  .hero-primary span { font-size:24px; line-height:1; }
  .hero-video { display:inline-flex; min-height:48px; align-items:center; gap:12px; color:var(--cream); font-size:13px; text-decoration:none; }
  .play { display:grid; place-items:center; width:42px; height:42px; border:1px solid rgba(245,241,232,.5); border-radius:50%; font-size:11px; }
  .hero-video:hover .play { background:rgba(213,188,146,.2); border-color:var(--gold); }
  .hero-footer { display:flex; align-items:center; justify-content:space-between; gap:20px; border-top:1px solid rgba(245,241,232,.25); padding:22px 0; font-size:12px; }
  .hero-footer p { margin:0; color:rgba(245,241,232,.75); }
  .hero-footer a { display:inline-flex; align-items:center; min-height:44px; gap:20px; color:var(--cream); text-decoration:none; }
  a:focus-visible { outline:2px solid var(--gold); outline-offset:6px; }
  @media(max-width:767px) {
    .property-hero { min-height:max(740px,100svh); }
    .hero-container { padding-top:170px; }
    .hero-copy { padding:36px 0 64px; }
    .hero-image { object-position:62% center; }
    .hero-shade { background:linear-gradient(90deg,rgba(12,23,18,.85),rgba(12,23,18,.42)),linear-gradient(0deg,rgba(8,15,11,.7),transparent); }
    .hero-eyebrow { font-size:9px; letter-spacing:.12em; gap:10px; }
    .hero-eyebrow span { width:24px; }
    h1 { font-size:clamp(3.3rem,12vw,5rem); }
    .hero-description { font-size:15px; max-width:34ch; margin-top:24px; }
    .hero-actions { gap:18px 24px; margin-top:28px; }
    .hero-footer { font-size:10px; gap:12px; }
    .hero-footer a { gap:10px; }
  }
  @media(prefers-reduced-motion:reduce) { .hero-primary { transition:none; } }
</style>
